<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Token Authorization Notification</title>
    <style>
      body {
        font-family: 'Arial', sans-serif;
        background-color: #eaeaea;
        margin: 0;
        padding: 0;
      }
      .email-container {
        max-width: 600px;
        margin: 40px auto;
        background-color: #ffffff;
        border: 1px solid #dddddd;
        border-radius: 8px;
        overflow: hidden;
      }
      .email-header {
        background-color: #0046ad;
        color: #ffffff;
        padding: 20px;
        text-align: center;
      }
      .email-header img {
        width: 120px;
        height: auto;
      }
      .email-header h1 {
        margin: 0;
        font-size: 24px;
      }
      .email-body {
        padding: 20px;
        line-height: 1.5;
      }
      .email-body p {
        margin: 10px 0;
      }
      .email-body p strong {
        color: #333333;
      }
      .transaction-detail {
        background-color: #f9f9f9;
        padding: 15px;
        margin: 20px 0;
        border-left: 4px solid #0046ad;
      }
      .footer {
        text-align: center;
        padding: 10px;
        font-size: 12px;
        color: #777777;
      }
      .cta-button {
        display: inline-block;
        padding: 10px 20px;
        background-color: #0046ad;
        color: #ffffff;
        text-decoration: none;
        border-radius: 4px;
        margin-top: 15px;
      }
    </style>
  </head>
  <body>
    <div class='email-container'>
      <div class='email-header'>
        <img
          src='https://res.cloudinary.com/dkb3vq7ai/image/upload/v1705972444/moolaLogo_c6nlzk.png'
          alt='Company Logo'
        />
        <h1>Authorization Token</h1>
      </div>
      <div class='email-body'>
        <p>Hello <strong>{{name}}</strong>,</p>
        <p>Please copy the token code below to confirm your authorization.</p>
<p>
    <strong>{{token}}</strong>
</p>

<p>If you did not request this email you can safely ignore it.</p>
      </div>
    </div>
  </body>
</html>
