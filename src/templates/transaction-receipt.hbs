<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Transaction Receipt</title>
    <style>
      body {
        font-family: 'Arial', sans-serif;
        background-color: #eaeaea;
        margin: 0;
        padding: 0;
      }
      .email-container {
        max-width: 700px;
        margin: 40px auto;
        background-color: #ffffff;
        border: 1px solid #dddddd;
        border-radius: 8px;
        overflow: hidden;
      }
      .email-header {
        background-color: #0046ad;
        color: #ffffff;
        padding: 20px;
        text-align: center;
      }
      .email-header img {
        width: 120px;
        height: auto;
      }
      .email-header h1 {
        margin: 0;
        font-size: 24px;
      }
      .email-body {
        font-family: Arial, sans-serif;
        background-color: #f4f6f8;
        padding: 30px;
      }
      .email-content {
        max-width: 700px;
        margin: auto;
        background-color: #ffffff;
        border-radius: 8px;
        padding: 25px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
      }
      .email-body p {
        font-size: 16px;
        color: #333333;
        margin: 10px 0;
      }
      .transaction-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        font-size: 15px;
      }
      .transaction-table td {
        padding: 10px;
        vertical-align: top;
      }
      .transaction-table td:first-child {
        background-color: #f0f2f5;
        font-weight: bold;
        width: 40%;
        color: #333;
      }
      .transaction-table td:last-child {
        background-color: #fbfcfe;
        color: #333;
      }
      .footer {
        text-align: center;
        padding: 10px;
        font-size: 12px;
        color: #777777;
      }
    </style>
  </head>
  <body>
    <div class='email-container'>
      <div class='email-header'>
        <img
          src='https://res.cloudinary.com/dkb3vq7ai/image/upload/v1705972444/moolaLogo_c6nlzk.png'
          alt='Company Logo'
        />
        <h1>Transaction Receipt</h1>
      </div>

      <div class='email-body'>
        <div class='email-content'>
          <p>Hello <strong>{{name}}</strong>,</p>
          <p>Thanks for using our service. Find below the details of your transaction:</p>

          <table class='transaction-table'>
            <tbody>
              <tr>
                <td>Account No:</td>
                <td>{{account}}</td>
              </tr>
              <tr>
                <td>Type:</td>
                <td>{{type}}</td>
              </tr>
              <tr>
                <td>Amount:</td>
                <td>{{amount}}</td>
              </tr>
              <tr>
                <td>Date:</td>
                <td>{{date}}</td>
              </tr>
              <tr>
                <td>Description:</td>
                <td>{{transactionDescription}}</td>
              </tr>
              <tr>
                <td>Recipient Name:</td>
                <td>{{recipientName}}</td>
              </tr>
              <tr>
                <td>Reference:</td>
                <td>{{reference}}</td>
              </tr>
              <tr>
                <td>Balance:</td>
                <td>{{availableBalance}}</td>
              </tr>
            </tbody>
          </table>

          <p style="font-size: 13px; color: #888888; margin-top: 30px;">This is an automated message, please do not reply.</p>
        </div>
      </div>
    </div>
  </body>
</html>