  conductedByPk Int?           @map("conducted_by_pk")
  conductedById String?        @map("conducted_by_id") @db.Uuid
  conductedBy   Staff?         @relation("training_conductor", fields: [conductedByPk, conductedById], references: [pk, id], onDelete: SetNull, onUpdate: Cascade)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([pk, id])
  @@map("guard_trainings")
}

model GuardCertification {
  pk               Int       @id @default(autoincrement())
  id               String    @unique @default(uuid()) @db.Uuid
  name             String
  issuingBody      String    @map("issuing_body")
  certificateNumber String?  @map("certificate_number")
  documentUrl      String?   @map("document_url")
  issuedAt         DateTime  @map("issued_at")
  expiresAt        DateTime? @map("expires_at")
  isExpired        Boolean   @default(false) @map("is_expired")
  notificationSent Boolean   @default(false) @map("notification_sent")

  guardPk   Int    @map("guard_pk")
  guardId   String @map("guard_id") @db.Uuid
  guard     Guard  @relation(fields: [guardPk, guardId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pk, id])
  @@map("guard_certifications")
}

model GuardKpiScore {
  pk              Int     @id @default(autoincrement())
  id              String  @unique @default(uuid()) @db.Uuid
  period          String  // "2025-01"
  attendanceScore Float   @default(0) @map("attendance_score")
  patrolScore     Float   @default(0) @map("patrol_score")
  incidentScore   Float   @default(0) @map("incident_score")
  overallScore    Float   @default(0) @map("overall_score")
  notes           String?

  guardPk Int    @map("guard_pk")
  guardId String @map("guard_id") @db.Uuid
  guard   Guard  @relation(fields: [guardPk, guardId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guardPk, period])
  @@unique([pk, id])
  @@map("guard_kpi_scores")
}

// ============================================================
// clients indiv and cooperates
// Each Client belongs to exactly one Company (the security
// firm servicing them).
// ============================================================

model Client {
  pk                  Int              @id @default(autoincrement())
  id                  String           @unique @default(uuid()) @db.Uuid
  clientType          ClientType       @map("client_type")
  onboardingMethod    OnboardingMethod @default(SELF_SIGNUP) @map("onboarding_method")
  status              ClientStatus     @default(ACTIVE)

  // Tenant scope — which security company services this client
  companyPk            Int             @map("company_pk")
  companyId            String          @map("company_id") @db.Uuid
  company              Company         @relation(fields: [companyPk, companyId], references: [pk, id], onDelete: Restrict, onUpdate: Cascade)

  // Shared identity
  name                String           // company name OR estate/residence name
  slug                String           @unique
  logo                String?
  email               String           @unique
  phone               String?          @unique
  password            String
  emailVerified       Boolean          @default(false) @map("email_verified")
  phoneVerified       Boolean          @default(false) @map("phone_verified")
  lastLoginAt         DateTime?        @map("last_login_at")

  // Address
  address             String?
  city                String?
  state               String?
  country             String?
  postalCode          String?          @map("postal_code")

  // Organization-specific (only for clientType = ORGANIZATION)
  industry            String?          // "Healthcare", "Education", etc.
  registrationNumber  String?          @map("registration_number")
  taxId               String?          @map("tax_id")

  // Individual-specific (only for clientType = INDIVIDUAL)
  individualType      IndividualAccountType? @map("individual_type")
  ownerFirstName      String?          @map("owner_first_name")
  ownerLastName       String?          @map("owner_last_name")
  ownerIdType         IdentificationCardType? @map("owner_id_type")
  ownerIdNumber       String?          @map("owner_id_number")
  ownerIdDocument     String?          @map("owner_id_document")
  ownerIdVerified     VerificationStatus @default(NOT_VERIFIED) @map("owner_id_verified")

  // Billing config — per client, configurable, defaults from Company
  defaultGuardPayoutPct Float          @default(0.30) @map("default_guard_payout_pct") // e.g. 0.30 = guard gets 30% of what client pays
  invoiceDueDays      Int              @default(30) @map("invoice_due_days")
  currency            String           @default("NGN")

  // Account manager — a Staff member of the SAME company
  accountManagerPk    Int?             @map("account_manager_pk")
  accountManagerId    String?          @map("account_manager_id") @db.Uuid
  accountManager      Staff?           @relation("account_manager", fields: [accountManagerPk, accountManagerId], references: [pk, id], onDelete: SetNull, onUpdate: Cascade)

  // Relations
  subscription        ClientSubscription?
  branches            ClientBranch[]
  sites               Site[]
  clientStaff         ClientStaff[]
  deployments         GuardDeployment[]
  incidents           Incident[]
  visitors            Visitor[]
  vehicles            Vehicle[]
  cameras             Camera[]
  invoices            Invoice[]
  reports             Report[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  apiKeys             ApiKey[]

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([pk, id])
  @@map("clients")
}

// Branch — only for ORGANIZATION clients
model ClientBranch {
  pk        Int      @id @default(autoincrement())
  id        String   @unique @default(uuid()) @db.Uuid
  name      String
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  country   String?
  active    Boolean  @default(true)

  clientPk  Int      @map("client_pk")
  clientId  String   @map("client_id") @db.Uuid
  client    Client   @relation(fields: [clientPk, clientId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  sites     Site[]
  clientStaff ClientStaff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pk, id])
  @@map("client_branches")
}

// ClientStaff — the client's own admin/operator users
// (different from a security company's internal Staff — these
// are client portal users, scoped via Client → Company)
model ClientStaff {
  pk             Int          @id @default(autoincrement())
  id             String       @unique @default(uuid()) @db.Uuid
  email          String       @unique
  phone          String?      @unique
  password       String
  role           String       // "ADMIN", "OPERATOR", "VIEWER" — flexible string
  active         ActiveStatus @default(ACTIVE)
  emailVerified  Boolean      @default(false) @map("email_verified")
  lastLoginAt    DateTime?    @map("last_login_at")

  clientPk       Int          @map("client_pk")
  clientId       String       @map("client_id") @db.Uuid
  client         Client       @relation(fields: [clientPk, clientId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  branchPk       Int?         @map("branch_pk")
  branchId       String?      @map("branch_id") @db.Uuid
  branch         ClientBranch? @relation(fields: [branchPk, branchId], references: [pk, id], onDelete: SetNull, onUpdate: Cascade)

  profile        ClientStaffProfile?
  notifications  Notification[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([pk, id])
  @@map("client_staff")
}

model ClientStaffProfile {
  pk            Int                     @id @default(autoincrement())
  id            String                  @unique @default(uuid()) @db.Uuid
  photo         String?
  firstName     String?                 @map("first_name")
  lastName      String?                 @map("last_name")
  gender        Gender?
  idType        IdentificationCardType? @map("id_type")
  idNumber      String?                 @map("id_number")
  idVerified    VerificationStatus      @default(NOT_VERIFIED) @map("id_verified")
  idDocument    String?                 @map("id_document")

  clientStaffPk Int                     @unique @map("client_staff_pk")
  clientStaffId String                  @unique @map("client_staff_id") @db.Uuid
  clientStaff   ClientStaff             @relation(fields: [clientStaffPk, clientStaffId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([pk, id])
  @@unique([clientStaffPk, clientStaffId])
  @@map("client_staff_profiles")
}

// ============================================================
// site
// this belongs to a client. Guards are deployed to sites.
// ============================================================

model Site {
  pk             Int                @id @default(autoincrement())
  id             String             @unique @default(uuid()) @db.Uuid
  name           String
  code           String             @unique
  classification SiteClassification @default(COMMERCIAL)
  address        String
  city           String?
  state          String?
  country        String?
  latitude       Float?
  longitude      Float?
  geofenceRadius Float?             @map("geofence_radius")
  active         Boolean            @default(true)
  mapImageUrl    String?            @map("map_image_url")
  description    String?

  clientPk       Int                @map("client_pk")
  clientId       String             @map("client_id") @db.Uuid
  client         Client             @relation(fields: [clientPk, clientId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  branchPk       Int?               @map("branch_pk")
  branchId       String?            @map("branch_id") @db.Uuid
  branch         ClientBranch?      @relation(fields: [branchPk, branchId], references: [pk, id], onDelete: SetNull, onUpdate: Cascade)

  deployments    GuardDeployment[]
  checkpoints    Checkpoint[]
  shifts         Shift[]
  cameras        Camera[]
  incidents      Incident[]
  visitors       Visitor[]
  vehicleEntries VehicleEntry[]
  patrols        Patrol[]
  parkingZones   ParkingZone[]

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([pk, id])
  @@map("sites")
}

// ============================================================
// gurad deployment
// The core operational record. Links a guard to a client + site.
// All shifts, attendance, patrols hang off this.
// When a contract is lost: status → ENDED, guard remains intact.
// When redeployed: new GuardDeployment row is created.
// ============================================================

model GuardDeployment {
  pk                  Int                  @id @default(autoincrement())
  id                  String               @unique @default(uuid()) @db.Uuid
  status              DeploymentStatus     @default(ACTIVE)
  startDate           DateTime             @map("start_date") @db.Date
  endDate             DateTime?            @map("end_date") @db.Date   // null = still active
  endReason           DeploymentEndReason? @map("end_reason")
  endNotes            String?              @map("end_notes")

  // Financial config — per deployment, per client negotiation
  // Client pays clientRate and guard gets guardPayRate
  clientRate          Float                @map("client_rate")         // what client pays per month for this guard
  guardPayRate        Float                @map("guard_pay_rate")      // what guard earns per month on this deployment
  guardPayoutPct      Float                @map("guard_payout_pct")    // snapshot of the % at time of deployment (for audit)
  currency            String               @default("NGN")

  guardPk             Int                  @map("guard_pk")
  guardId             String               @map("guard_id") @db.Uuid
  guard               Guard                @relation(fields: [guardPk, guardId], references: [pk, id], onDelete: Restrict, onUpdate: Cascade)

  clientPk            Int                  @map("client_pk")
  clientId            String               @map("client_id") @db.Uuid
  client              Client               @relation(fields: [clientPk, clientId], references: [pk, id], onDelete: Restrict, onUpdate: Cascade)

  sitePk              Int                  @map("site_pk")
  siteId              String               @map("site_id") @db.Uuid
  site                Site                 @relation(fields: [sitePk, siteId], references: [pk, id], onDelete: Restrict, onUpdate: Cascade)

  // All operational activity on this deployment
  guardShifts         GuardShift[]
  attendance          AttendanceRecord[]
  patrols             Patrol[]
  payrollLines        PayrollLine[]        // payroll lines generated from this deployment
  invoiceLines        InvoiceLineItem[]    // invoice lines billed to client from this deployment

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([pk, id])
  @@map("guard_deployments")
}

// ============================================================
// shift and attendance
// Shifts are site-level templates. GuardShifts are the actual
// scheduled instances per guard per deployment.
// ============================================================

model Shift {
  pk          Int       @id @default(autoincrement())
  id          String    @unique @default(uuid()) @db.Uuid
  name        String
  type        ShiftType
  startTime   String    @map("start_time") // "06:00"
  endTime     String    @map("end_time")   // "18:00"
  daysOfWeek  Int[]     @map("days_of_week")
  active      Boolean   @default(true)

  sitePk      Int       @map("site_pk")
  siteId      String    @map("site_id") @db.Uuid
  site        Site      @relation(fields: [sitePk, siteId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  guardShifts GuardShift[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([pk, id])
  @@map("shifts")
}

model GuardShift {
  pk             Int             @id @default(autoincrement())
  id             String          @unique @default(uuid()) @db.Uuid
  date           DateTime        @db.Date
  startTime      DateTime        @map("start_time")
  endTime        DateTime        @map("end_time")
  status         PatrolStatus    @default(SCHEDULED)
  notes          String?

  shiftPk        Int             @map("shift_pk")
  shiftId        String          @map("shift_id") @db.Uuid
  shift          Shift           @relation(fields: [shiftPk, shiftId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  // Linked to deployment — not directly to guard or client
  deploymentPk   Int             @map("deployment_pk")
  deploymentId   String          @map("deployment_id") @db.Uuid
  deployment     GuardDeployment @relation(fields: [deploymentPk, deploymentId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  attendance     AttendanceRecord?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([pk, id])
  @@map("guard_shifts")
}

model AttendanceRecord {
  pk                Int              @id @default(autoincrement())
  id                String           @unique @default(uuid()) @db.Uuid
  checkInTime       DateTime?        @map("check_in_time")
  checkOutTime      DateTime?        @map("check_out_time")
  checkInMethod     AttendanceMethod? @map("check_in_method")
  checkOutMethod    AttendanceMethod? @map("check_out_method")
  checkInLatitude   Float?           @map("check_in_latitude")
  checkInLongitude  Float?           @map("check_in_longitude")
  checkOutLatitude  Float?           @map("check_out_latitude")
  checkOutLongitude Float?           @map("check_out_longitude")
  checkInQrCode     String?          @map("check_in_qr_code")
  hoursWorked       Float?           @map("hours_worked")
  isLate            Boolean          @default(false) @map("is_late")
  isAbsent          Boolean          @default(false) @map("is_absent")
  notes             String?

  // Linked to deployment — this gives us full context (guard + client + site)
  deploymentPk      Int              @map("deployment_pk")
  deploymentId      String           @map("deployment_id") @db.Uuid
  deployment        GuardDeployment  @relation(fields: [deploymentPk, deploymentId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  guardShiftPk      Int?             @unique @map("guard_shift_pk")
  guardShiftId      String?          @unique @map("guard_shift_id") @db.Uuid
  guardShift        GuardShift?      @relation(fields: [guardShiftPk, guardShiftId], references: [pk, id], onDelete: SetNull, onUpdate: Cascade)

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([pk, id])
  @@unique([guardShiftPk, guardShiftId])
  @@map("attendance_records")
}

model LeaveRequest {
  pk          Int         @id @default(autoincrement())
  id          String      @unique @default(uuid()) @db.Uuid
  type        LeaveType
  startDate   DateTime    @map("start_date") @db.Date
  endDate     DateTime    @map("end_date") @db.Date
  totalDays   Int         @map("total_days")
  reason      String?
  status      LeaveStatus @default(PENDING)
  reviewedAt  DateTime?   @map("reviewed_at")
  reviewNotes String?     @map("review_notes")
  documentUrl String?     @map("document_url")

  guardPk     Int         @map("guard_pk")
  guardId     String      @map("guard_id") @db.Uuid
  guard       Guard       @relation(fields: [guardPk, guardId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  approverPk  Int?        @map("approver_pk")
  approverId  String?     @map("approver_id") @db.Uuid
  approver    Staff?      @relation("leave_approver", fields: [approverPk, approverId], references: [pk, id], onDelete: SetNull, onUpdate: Cascade)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([pk, id])
  @@map("leave_requests")
}

model OvertimeRequest {
  pk          Int            @id @default(autoincrement())
  id          String         @unique @default(uuid()) @db.Uuid
  date        DateTime       @db.Date
  hours       Float
  reason      String?
  status      OvertimeStatus @default(PENDING)
  reviewedAt  DateTime?      @map("reviewed_at")
  reviewNotes String?        @map("review_notes")

  guardPk     Int            @map("guard_pk")
  guardId     String         @map("guard_id") @db.Uuid
  guard       Guard          @relation(fields: [guardPk, guardId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  approverPk  Int?           @map("approver_pk")
  approverId  String?        @map("approver_id") @db.Uuid
  approver    Staff?         @relation("overtime_approver", fields: [approverPk, approverId], references: [pk, id], onDelete: SetNull, onUpdate: Cascade)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([pk, id])
  @@map("overtime_requests")
}

// ============================================================
// payroll
// Auto-generated at month end based on active GuardDeployments,
// scoped per Company (each tenant runs its own payroll).
// One PayrollRun per company per month. One PayrollLine per
// deployment. HR reviews draft → approves → marks paid.
// ============================================================

model PayrollRun {
  pk              Int              @id @default(autoincrement())
  id              String           @unique @default(uuid()) @db.Uuid
  period          String           // "2025-01" — the month this covers
  periodStart     DateTime         @map("period_start") @db.Date
  periodEnd       DateTime         @map("period_end") @db.Date
  status          PayrollRunStatus @default(DRAFT)
  totalGross      Float            @default(0) @map("total_gross")  // sum of all guardPayRate lines
  totalNet        Float            @default(0) @map("total_net")    // after deductions
  totalDeductions Float            @default(0) @map("total_deductions")
  notes           String?
  generatedAt     DateTime         @default(now()) @map("generated_at")
  submittedAt     DateTime?        @map("submitted_at")
  approvedAt      DateTime?        @map("approved_at")
  paidAt          DateTime?        @map("paid_at")

  companyPk       Int              @map("company_pk")
  companyId       String           @map("company_id") @db.Uuid
  company         Company          @relation(fields: [companyPk, companyId], references: [pk, id], onDelete: Restrict, onUpdate: Cascade)

  approvedByPk    Int?             @map("approved_by_pk")
  approvedById    String?          @map("approved_by_id") @db.Uuid
  approvedBy      Staff?           @relation("payroll_approver", fields: [approvedByPk, approvedById], references: [pk, id], onDelete: SetNull, onUpdate: Cascade)

  lines           PayrollLine[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([companyPk, period])  // one run per company per month
  @@unique([pk, id])
  @@map("payroll_runs")
}

model PayrollLine {
  pk                Int              @id @default(autoincrement())
  id                String           @unique @default(uuid()) @db.Uuid
  status            PayrollLineStatus @default(INCLUDED)

  // Computed from deployment for the period
  daysWorked        Float            @map("days_worked")
  hoursWorked       Float            @map("hours_worked")
  grossAmount       Float            @map("gross_amount")   // guardPayRate prorated for days worked
  deductions        Float            @default(0)            // tax, pension, etc.
  netAmount         Float            @map("net_amount")     // grossAmount - deductions
  overtimeAmount    Float            @default(0) @map("overtime_amount")
  adjustmentAmount  Float            @default(0) @map("adjustment_amount") // HR manual adjustment
  adjustmentReason  String?          @map("adjustment_reason")
  notes             String?

  // Snapshot for audit — rates at time of payroll generation
  snapshotClientRate   Float         @map("snapshot_client_rate")
  snapshotGuardPayRate Float         @map("snapshot_guard_pay_rate")
  snapshotPayoutPct    Float         @map("snapshot_payout_pct")

  payrollRunPk      Int              @map("payroll_run_pk")
  payrollRunId      String           @map("payroll_run_id") @db.Uuid
  payrollRun        PayrollRun       @relation(fields: [payrollRunPk, payrollRunId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  guardPk           Int              @map("guard_pk")
  guardId           String           @map("guard_id") @db.Uuid
  guard             Guard            @relation(fields: [guardPk, guardId], references: [pk, id], onDelete: Restrict, onUpdate: Cascade)

  deploymentPk      Int              @map("deployment_pk")
  deploymentId      String           @map("deployment_id") @db.Uuid
  deployment        GuardDeployment  @relation(fields: [deploymentPk, deploymentId], references: [pk, id], onDelete: Restrict, onUpdate: Cascade)

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([pk, id])
  @@map("payroll_lines")
}

// ============================================================
// invoiceing client,
// Generated per client per billing period.
// Each deployed guard = one InvoiceLineItem at clientRate.
// Separate from payroll — client never sees guard pay rates.
// ============================================================

model Invoice {
  pk              Int           @id @default(autoincrement())
  id              String        @unique @default(uuid()) @db.Uuid
  invoiceNumber   String        @unique @map("invoice_number")
  period          String        // "2025-01"
  periodStart     DateTime      @map("period_start") @db.Date
  periodEnd       DateTime      @map("period_end") @db.Date
  status          InvoiceStatus @default(DRAFT)
  subtotal        Float         @default(0)
  taxAmount       Float         @default(0) @map("tax_amount")
  taxRate         Float         @default(0) @map("tax_rate")
  totalAmount     Float         @default(0) @map("total_amount")
  amountPaid      Float         @default(0) @map("amount_paid")
  amountDue       Float         @default(0) @map("amount_due")
  currency        String        @default("NGN")
  dueDate         DateTime      @map("due_date") @db.Date
  sentAt          DateTime?     @map("sent_at")
  paidAt          DateTime?     @map("paid_at")
  notes           String?
  pdfUrl          String?       @map("pdf_url")

  clientPk        Int           @map("client_pk")
  clientId        String        @map("client_id") @db.Uuid
  client          Client        @relation(fields: [clientPk, clientId], references: [pk, id], onDelete: Restrict, onUpdate: Cascade)

  lineItems       InvoiceLineItem[]
  payments        InvoicePayment[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([pk, id])
  @@map("invoices")
}

model InvoiceLineItem {
  pk             Int             @id @default(autoincrement())
  id             String          @unique @default(uuid()) @db.Uuid
  type           InvoiceLineType @default(GUARD_SERVICE)
  description    String          // e.g. "Guard – Black shadow – Jan 2025"
  quantity       Float           @default(1)   // days or units
  unitPrice      Float           @map("unit_price")
  amount         Float
  notes          String?

  invoicePk      Int             @map("invoice_pk")
  invoiceId      String          @map("invoice_id") @db.Uuid
  invoice        Invoice         @relation(fields: [invoicePk, invoiceId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  // For GUARD_SERVICE lines, link to the deployment for traceability
  deploymentPk   Int?            @map("deployment_pk")
  deploymentId   String?         @map("deployment_id") @db.Uuid
  deployment     GuardDeployment? @relation(fields: [deploymentPk, deploymentId], references: [pk, id], onDelete: SetNull, onUpdate: Cascade)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([pk, id])
  @@map("invoice_line_items")
}

model InvoicePayment {
  pk            Int           @id @default(autoincrement())
  id            String        @unique @default(uuid()) @db.Uuid
  amount        Float
  method        PaymentMethod
  reference     String?       // bank ref, cheque number, etc.
  paidAt        DateTime      @map("paid_at")
  notes         String?

  invoicePk     Int           @map("invoice_pk")
  invoiceId     String        @map("invoice_id") @db.Uuid
  invoice       Invoice       @relation(fields: [invoicePk, invoiceId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([pk, id])
  @@map("invoice_payments")
}

