  MOTION_BASED
  EVENT_BASED
}

enum AlertType {
  CAMERA_OFFLINE
  MOTION_DETECTED
  INTRUSION
  TAMPERING
  FIRE
  PANIC
  ACCESS_DENIED
}

enum AlertStatus {
  ACTIVE
