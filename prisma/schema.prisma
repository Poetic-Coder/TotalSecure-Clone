// roles and permission
// Role can be a global/system role (companyPk = null, usable
// by any tenant) or a custom role scoped to one Company.
// Permission stays a global, platform-defined catalogue.
// ============================================================

model Role {
  pk          Int     @id @default(autoincrement())
  id          String  @unique @default(uuid()) @db.Uuid
  name        String
  description String?
  isSystem    Boolean @default(false) @map("is_system") // true = built-in, shared across all companies

  // null = system/global role; set = custom role owned by that Company
  companyPk   Int?    @map("company_pk")
  companyId   String? @map("company_id") @db.Uuid
  company     Company? @relation(fields: [companyPk, companyId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  permissions RolePermission[]
  staffUsingRole Staff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pk, id])
  @@unique([companyPk, name])
  @@map("roles")
}

model Permission {
  pk          Int     @id @default(autoincrement())
  id          String  @unique @default(uuid()) @db.Uuid
  name        String  @unique // "incident:create"
  module      String           // "INCIDENT"
  action      String           // "CREATE"
  description String?

  roles               RolePermission[]
  staffOverrides      StaffPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pk, id])
  @@map("permissions")
}

model RolePermission {
  pk Int    @id @default(autoincrement())
  id String @unique @default(uuid()) @db.Uuid

  rolePk Int    @map("role_pk")
  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [rolePk, roleId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  permissionPk Int        @map("permission_pk")
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionPk, permissionId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@unique([rolePk, permissionPk])
  @@unique([pk, id])
  @@map("role_permissions")
}

// Per-staff permission overrides (do not change the shared role).
// effective = (role permissions − DENY) ∪ GRANT
model StaffPermission {
  pk     Int              @id @default(autoincrement())
  id     String           @unique @default(uuid()) @db.Uuid
  effect PermissionEffect

  staffPk Int    @map("staff_pk")
  staffId String @map("staff_id") @db.Uuid
  staff   Staff  @relation(fields: [staffPk, staffId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  permissionPk Int        @map("permission_pk")
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionPk, permissionId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffPk, permissionPk])
  @@unique([pk, id])
  @@map("staff_permissions")
}

// ============================================================
// reprts
// ============================================================

model Report {
  pk            Int          @id @default(autoincrement())
  id            String       @unique @default(uuid()) @db.Uuid
  title         String
  type          ReportType
  format        ReportFormat @default(PDF)
  filters       Json?
  fileUrl       String?      @map("file_url")
  generatedAt   DateTime?    @map("generated_at")
  periodStart   DateTime?    @map("period_start") @db.Date
  periodEnd     DateTime?    @map("period_end") @db.Date
  isScheduled   Boolean      @default(false) @map("is_scheduled")
  scheduleConfig Json?       @map("schedule_config")

  clientPk  Int?    @map("client_pk")
  clientId  String? @map("client_id") @db.Uuid
  client    Client? @relation(fields: [clientPk, clientId], references: [pk, id], onDelete: SetNull, onUpdate: Cascade)

  generatedByPk Int?    @map("generated_by_pk")
  generatedById String? @map("generated_by_id") @db.Uuid
  generatedBy   Staff?  @relation(fields: [generatedByPk, generatedById], references: [pk, id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pk, id])
  @@map("reports")
}

// ============================================================
// notifications
// ============================================================

model Notification {
  pk       Int              @id @default(autoincrement())
  id       String           @unique @default(uuid()) @db.Uuid
  type     NotificationType
  title    String
  message  String
  isRead   Boolean          @default(false) @map("is_read")
  readAt   DateTime?        @map("read_at")
  metadata Json?

  staffPk Int?    @map("staff_pk")
  staffId String? @map("staff_id") @db.Uuid
  staff   Staff?  @relation(fields: [staffPk, staffId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  guardPk Int?    @map("guard_pk")
  guardId String? @map("guard_id") @db.Uuid
  guard   Guard?  @relation(fields: [guardPk, guardId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  clientStaffPk Int?         @map("client_staff_pk")
  clientStaffId String?      @map("client_staff_id") @db.Uuid
  clientStaff   ClientStaff? @relation(fields: [clientStaffPk, clientStaffId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  clientPk Int?    @map("client_pk")
  clientId String? @map("client_id") @db.Uuid
  client   Client? @relation(fields: [clientPk, clientId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  // Company-level notifications — e.g. plan limits, subscription status
  companyPk Int?    @map("company_pk")
  companyId String? @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyPk, companyId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pk, id])
  @@map("notifications")
}

// ============================================================
// api keys
// ============================================================

model ApiKey {
  pk           Int       @id @default(autoincrement())
  id           String    @unique @default(uuid()) @db.Uuid
  key          String    @unique
  active       Boolean   @default(true)
  description  String?
  expiresAt    DateTime? @map("expires_at")
  lastUsed     DateTime? @map("last_used")
  rateLimit    Int       @default(1000) @map("rate_limit")
  requestCount Int       @default(0) @map("request_count")
  resetAt      DateTime  @default(now()) @map("reset_at")

  // Company-level API key (platform API access granted to the tenant as a whole)
  companyPk Int?    @map("company_pk")
  companyId String? @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyPk, companyId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  staffPk Int?    @map("staff_pk")
  staffId String? @map("staff_id") @db.Uuid
  staff   Staff?  @relation(fields: [staffPk, staffId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  guardPk Int?    @map("guard_pk")
  guardId String? @map("guard_id") @db.Uuid
  guard   Guard?  @relation(fields: [guardPk, guardId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  clientPk Int?    @map("client_pk")
  clientId String? @map("client_id") @db.Uuid
  client   Client? @relation(fields: [clientPk, clientId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffPk, staffId])
  @@unique([guardPk, guardId])
  @@unique([clientPk, clientId])
  @@unique([pk, id])
  @@map("api_keys")
}

// ============================================================
// audit log
// ============================================================

model AuditLog {
  pk          Int         @id @default(autoincrement())
  id          String      @unique @default(uuid()) @db.Uuid
  action      AuditAction
  module      String
  targetId    String?     @map("target_id")
  targetType  String?     @map("target_type")
  description String?
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  metadata    Json?

  // Which tenant this audit event belongs to (null = platform-level event)
  companyPk Int?    @map("company_pk")
  companyId String? @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyPk, companyId], references: [pk, id], onDelete: SetNull, onUpdate: Cascade)

  staffPk Int?    @map("staff_pk")
  staffId String? @map("staff_id") @db.Uuid
  staff   Staff?  @relation(fields: [staffPk, staffId], references: [pk, id], onDelete: SetNull, onUpdate: Cascade)

  clientPk Int?    @map("client_pk")
  clientId String? @map("client_id") @db.Uuid
  client   Client? @relation(fields: [clientPk, clientId], references: [pk, id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@unique([pk, id])
  @@map("audit_logs")
}
