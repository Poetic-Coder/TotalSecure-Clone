  CANCELLED
  DISPUTED
}

enum InvoiceLineType {
  GUARD_SERVICE      // Per guard per period
  SUBSCRIPTION_FEE   // Recurring ServicePackage fee for the period
  OVERTIME           // Extra hours billed to client
  EQUIPMENT_FEE
  MANAGEMENT_FEE
  PENALTY
  DISCOUNT
  OTHER
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  ONLINE
}

// ------ subs ------

enum PlanTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum ServiceTier {
  BASIC
  STANDARD
  PREMIUM
  CUSTOM
}

// ------ misc ------

enum NotificationType {
  INCIDENT_REPORTED
  INCIDENT_ESCALATED
  PATROL_MISSED
  GUARD_ABSENT
  VISITOR_ARRIVAL
  CAMERA_OFFLINE
  ALERT_TRIGGERED
  LEAVE_REQUEST
  OVERTIME_REQUEST
  PAYROLL_GENERATED
  INVOICE_DUE
  DEPLOYMENT_ENDED
  GUARD_READY
  SYSTEM_ALERT
  SUBSCRIPTION_EXPIRING   // NEW — plan/trial about to end for a Company
  PLAN_LIMIT_REACHED      // NEW — a Company hit a plan limit (sites, guards, etc.)
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PASSWORD_RESET
  PERMISSION_CHANGE
  EXPORT
  APPROVE
  REJECT
}

enum ReportType {
  INCIDENT
  PATROL
  ATTENDANCE
  VISITOR
  VEHICLE
  KPI
  COMPLIANCE
  RISK
  PAYROLL
  DEPLOYMENT
  CUSTOM
}

enum ReportFormat {
  PDF
  EXCEL
  CSV
}

enum PermissionModule {
  GUARD
  SITE
  CLIENT  // Includes client staff and client branch
  SUBSCRIPTION
  DEPLOYMENT  // Handles guard deployments
  SHIFT // Handles Guard shifts
  INVOICE
  EQUIPMENT
  INCIDENT
  CONMMAND_CENTER   // Includes Report, Alerts and Camera
  VEHICLE   // includes vehicle parking
  PATROL  // Handles Patrol routes and patrol guards
  VISITOR
  AUDITLOG
  NOTIFICATION
  STAFF
  ROLE
  PAYROLL
  COMPANY
}

// Per-user permission override on top of a role baseline.
// GRANT = add a permission the role does not have (for this user only)
// DENY  = remove a permission the role has (for this user only)
enum PermissionEffect {
  GRANT
  DENY
}

// ============================================================
// PLATFORM STAFF
// The people who run the platform itself, across every
// tenant Company. Distinct from a Company's own Staff.
// ============================================================

model PlatformStaff {
  pk            Int               @id @default(autoincrement())
  id            String            @unique @default(uuid()) @db.Uuid
  email         String            @unique
  phone         String?           @unique
  password      String
  role          PlatformStaffRole
  active        ActiveStatus      @default(ACTIVE)
  firstName     String?           @map("first_name")
  lastName      String?           @map("last_name")
  lastLoginAt   DateTime?         @map("last_login_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pk, id])
  @@map("platform_staff")
}

// ============================================================
// COMPANY (TENANT ROOT)
// A security company that has onboarded onto the platform.
// Owns its own Staff, Guards, Roles, Equipment pool, and
// book of Clients. This is the multi-tenancy boundary.
// ============================================================

model Company {
  pk                 Int           @id @default(autoincrement())
  id                 String        @unique @default(uuid()) @db.Uuid
  name               String
  slug               String        @unique
  logo               String?
  email              String        @unique
  phone              String?       @unique
  password           String
  status             CompanyStatus @default(ACTIVE)
  emailVerified      Boolean       @default(false) @map("email_verified")
  phoneVerified      Boolean       @default(false) @map("phone_verified")
  lastLoginAt        DateTime?     @map("last_login_at")

  registrationNumber String?       @map("registration_number")
  taxId               String?      @map("tax_id")
  address             String?
  city                String?
  state               String?
  country             String?
  postalCode          String?      @map("postal_code")
  currency            String       @default("NGN")

  // Guard payout default — company-level default for how much of the
  // clientRate a guard receives; individual clients/deployments may
  // still override via Client.defaultGuardPayoutPct / GuardDeployment.guardPayoutPct
  defaultGuardPayoutPct Float      @default(0.30) @map("default_guard_payout_pct")

  // Relations — everything this tenant owns
  subscription        CompanySubscription?
  staff                Staff[]
  guards               Guard[]
  clients              Client[]
  customRoles          Role[]
  servicePackages      ServicePackage[]
  equipment            Equipment[]
  apiKeys              ApiKey[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  payrollRuns          PayrollRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pk, id])
  @@map("companies")
}

// ============================================================
// PLATFORM PLANS  (level 1 billing: platform -> company)
// Controls which features/limits each COMPANY (tenant) can
// access on the platform. Platform admin seeds plans; each
// company subscribes to exactly one.
// NOT to be confused with ServicePackage, which is the
// catalogue a company sells to its own clients.
// ============================================================

model PlatformPlan {
  pk                      Int          @id @default(autoincrement())
  id                      String       @unique @default(uuid()) @db.Uuid
  name                    String       @unique
  tier                    PlanTier
  description             String?
  monthlyPrice            Float        @map("monthly_price")
  quarterlyPrice          Float?       @map("quarterly_price")
  annualPrice             Float?       @map("annual_price")
  currency                String       @default("NGN")

  // Hard limits (null = unlimited) — now bound a whole Company's
  // usage across ALL of its clients/sites/guards/cameras/staff
  maxClients              Int?         @map("max_clients")
  maxSites                Int?         @map("max_sites")
  maxGuardsDeployed       Int?         @map("max_guards_deployed")
  maxCameras              Int?         @map("max_cameras")
  maxStaffUsers           Int?         @map("max_staff_users")
  storageRetentionDays    Int          @default(30) @map("storage_retention_days")

  // Feature flags per PRD module
  hasGuardManagement      Boolean      @default(true)  @map("has_guard_management")
  hasPatrolManagement     Boolean      @default(true)  @map("has_patrol_management")
  hasVisitorManagement    Boolean      @default(true)  @map("has_visitor_management")
  hasVehicleManagement    Boolean      @default(true)  @map("has_vehicle_management")
  hasIncidentManagement   Boolean      @default(true)  @map("has_incident_management")
  hasCctvIntegration      Boolean      @default(false) @map("has_cctv_integration")
  hasCommandCenter        Boolean      @default(false) @map("has_command_center")
  hasReporting            Boolean      @default(true)  @map("has_reporting")
  hasAdvancedAnalytics    Boolean      @default(false) @map("has_advanced_analytics")
  hasApiAccess            Boolean      @default(false) @map("has_api_access")
  hasBiometricCheckin     Boolean      @default(false) @map("has_biometric_checkin")
  hasSmsAlerts            Boolean      @default(false) @map("has_sms_alerts")
  hasEmailAlerts          Boolean      @default(true)  @map("has_email_alerts")
  hasMultiBranch          Boolean      @default(false) @map("has_multi_branch")
  hasCustomRoles          Boolean      @default(false) @map("has_custom_roles")
  active                  Boolean      @default(true)

  companySubscriptions    CompanySubscription[]

  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@unique([pk, id])
  @@map("platform_plans")
}

// Company subscription to a platform plan
model CompanySubscription {
  pk                 Int                @id @default(autoincrement())
  id                 String             @unique @default(uuid()) @db.Uuid
  status             SubscriptionStatus @default(TRIALING)
  billingCycle       BillingCycle       @default(MONTHLY) @map("billing_cycle")
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  cancelledAt        DateTime?          @map("cancelled_at")
  externalRef        String?            @map("external_ref")

  companyPk          Int                @unique @map("company_pk")
  companyId          String             @unique @map("company_id") @db.Uuid
  company            Company            @relation(fields: [companyPk, companyId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  planPk             Int                @map("plan_pk")
  planId             String             @map("plan_id") @db.Uuid
  plan               PlatformPlan       @relation(fields: [planPk, planId], references: [pk, id], onDelete: Restrict, onUpdate: Cascade)

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([pk, id])
  @@unique([companyPk, companyId])
  @@map("company_subscriptions")
}

// ============================================================
// SERVICE PACKAGES  (billing company -> its clients)
// Each security company defines its OWN catalogue of guarding
// packages to sell. Company-scoped: Firm A's "Premium" has
// nothing to do with Firm B's "Premium".
//
// A package may not enable a feature the owning Company's
// PlatformPlan does not grant — validate on create/update.
// ============================================================

model ServicePackage {
  pk                    Int          @id @default(autoincrement())
  id                    String       @unique @default(uuid()) @db.Uuid
  name                  String       // company-chosen, e.g. "Estate Essential"
  tier                  ServiceTier  @default(STANDARD)
  description           String?
  forClientType         ClientType?  @map("for_client_type") // null = offer to both

  // Pricing — what the CLIENT pays the COMPANY, recurring, on top of
  // (or inclusive of) per-guard GuardDeployment.clientRate billing.
  monthlyPrice          Float        @map("monthly_price")
  quarterlyPrice        Float?       @map("quarterly_price")
  annualPrice           Float?       @map("annual_price")
  currency              String       @default("NGN")
  setupFee              Float        @default(0) @map("setup_fee")

  // Whether the recurring fee already covers some guards, or whether
  // every guard is billed separately via GuardDeployment.clientRate.
  includedGuardCount    Int          @default(0) @map("included_guard_count")
  billGuardsSeparately  Boolean      @default(true) @map("bill_guards_separately")

  // Limits this package grants the client (null = unlimited)
  maxSites              Int?         @map("max_sites")
  maxCameras            Int?         @map("max_cameras")
  maxPortalUsers        Int?         @map("max_portal_users") // ClientStaff seats
  maxVisitorsPerMonth   Int?         @map("max_visitors_per_month")
  storageRetentionDays  Int          @default(30) @map("storage_retention_days")

  hasPatrolVisibility   Boolean      @default(true)  @map("has_patrol_visibility")
  hasVisitorManagement  Boolean      @default(true)  @map("has_visitor_management")
  hasVehicleManagement  Boolean      @default(true)  @map("has_vehicle_management")
  hasIncidentPortal     Boolean      @default(true)  @map("has_incident_portal")
  hasCctvAccess         Boolean      @default(false) @map("has_cctv_access")
  hasLiveTracking       Boolean      @default(false) @map("has_live_tracking")
  hasReporting          Boolean      @default(true)  @map("has_reporting")
  hasAdvancedAnalytics  Boolean      @default(false) @map("has_advanced_analytics")
  hasSmsAlerts          Boolean      @default(false) @map("has_sms_alerts")
  hasEmailAlerts        Boolean      @default(true)  @map("has_email_alerts")
  hasDedicatedManager   Boolean      @default(false) @map("has_dedicated_manager")
  responseTimeSlaMins   Int?         @map("response_time_sla_mins")

  active                Boolean      @default(true)
  isPublic              Boolean      @default(true) @map("is_public") // show on self-signup

  // Owning company (tenant)
  companyPk             Int          @map("company_pk")
  companyId             String       @map("company_id") @db.Uuid
  company               Company      @relation(fields: [companyPk, companyId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  clientSubscriptions   ClientSubscription[]

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@unique([pk, id])
  @@unique([companyPk, name])   // package names unique within a company only
  @@map("service_packages")
}

// A client's subscription to one of its security company's packages.
// The ServicePackage must belong to the same Company as the Client
model ClientSubscription {
  pk                 Int                @id @default(autoincrement())
  id                 String             @unique @default(uuid()) @db.Uuid
  status             SubscriptionStatus @default(TRIALING)
  billingCycle       BillingCycle       @default(MONTHLY) @map("billing_cycle")
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  cancelledAt        DateTime?          @map("cancelled_at")
  cancelReason       String?            @map("cancel_reason")
  autoRenew          Boolean            @default(true) @map("auto_renew")
  startedAt          DateTime           @default(now()) @map("started_at")
  externalRef        String?            @map("external_ref")

  // Price snapshot at subscribe time — package pricing may change later,
  // but an existing subscriber keeps the agreed rate until renewal.
  agreedPrice        Float              @map("agreed_price")
  discountPct        Float              @default(0) @map("discount_pct")
  currency           String             @default("NGN")

  clientPk           Int                @unique @map("client_pk")
  clientId           String             @unique @map("client_id") @db.Uuid
  client             Client             @relation(fields: [clientPk, clientId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  packagePk          Int                @map("package_pk")
  packageId          String             @map("package_id") @db.Uuid
  package            ServicePackage     @relation(fields: [packagePk, packageId], references: [pk, id], onDelete: Restrict, onUpdate: Cascade)

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([pk, id])
  @@unique([clientPk, clientId])
  @@map("client_subscriptions")
}

// ============================================================
// internal staff
// A company's own employees — HR, Operations, Finance, etc.
// Scoped to exactly one Company (tenant). Separate from
// guards, clients, and platform staff.
// ============================================================

model Staff {
  pk              Int          @id @default(autoincrement())
  id              String       @unique @default(uuid()) @db.Uuid
  employeeId      String       @unique @map("employee_id")
  email           String       @unique
  phone           String?      @unique
  password        String
  role            StaffRole
  active          ActiveStatus @default(ACTIVE)
  emailVerified   Boolean      @default(false) @map("email_verified")
  phoneVerified   Boolean      @default(false) @map("phone_verified")
  lastLoginAt     DateTime?    @map("last_login_at")

  // Tenant scope
  companyPk       Int          @map("company_pk")
  companyId       String       @map("company_id") @db.Uuid
  company         Company      @relation(fields: [companyPk, companyId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  // Optional fine-grained custom role
  customRolePk    Int?         @map("custom_role_pk")
  customRoleId    String?      @map("custom_role_id") @db.Uuid
  customRole      Role?        @relation(fields: [customRolePk, customRoleId], references: [pk, id], onDelete: SetNull, onUpdate: Cascade)

  // Hierarchy (dis must remain within the same company)
  managerPk       Int?         @map("manager_pk")
  managerId       String?      @map("manager_id") @db.Uuid
  manager         Staff?       @relation("StaffHierarchy", fields: [managerPk, managerId], references: [pk, id], onDelete: SetNull, onUpdate: Cascade)
  subordinates    Staff[]      @relation("StaffHierarchy")

  profile                   StaffProfile?
  apiKeys                   ApiKey[]
  notifications             Notification[]
  auditLogs                 AuditLog[]
  permissionOverrides       StaffPermission[]

  // Operational responsibilities
  managedClients            Client[]               @relation("account_manager")
  assignedIncidents         Incident[]             @relation("incident_assignee")
  incidentInvestigations    IncidentInvestigation[]
  approvedLeaves            LeaveRequest[]         @relation("leave_approver")
  approvedOvertimes         OvertimeRequest[]      @relation("overtime_approver")
  approvedPayrollRuns       PayrollRun[]           @relation("payroll_approver")
  generatedReports          Report[]
  conductedTrainings        GuardTraining[]        @relation("training_conductor")
  conductedBackgroundChecks GuardBackgroundCheck[] @relation("background_checker")

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([pk, id])
  @@map("staff")
}

model StaffProfile {
  pk          Int                     @id @default(autoincrement())
  id          String                  @unique @default(uuid()) @db.Uuid
  photo       String?
  dob         DateTime?
  firstName   String?                 @map("first_name")
  lastName    String?                 @map("last_name")
  middleName  String?                 @map("middle_name")
  gender      Gender?
  nationality String?
  homeAddress String?                 @map("home_address")
  city        String?
  state       String?
  country     String?
  postalCode  String?                 @map("postal_code")
  idType      IdentificationCardType? @map("id_type")
  idNumber    String?                 @map("id_number")
  idVerified  VerificationStatus      @default(NOT_VERIFIED) @map("id_verified")
  idDocument  String?                 @map("id_document")

  staffPk     Int                     @unique @map("staff_pk")
  staffId     String                  @unique @map("staff_id") @db.Uuid
  staff       Staff                   @relation(fields: [staffPk, staffId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([pk, id])
  @@unique([staffPk, staffId])
  @@map("staff_profiles")
}

// ============================================================
// guard
// Employed by exactly one Company (tenant). Deployed to that
// company's clients/sites only.
// ============================================================

model Guard {
  pk                  Int                @id @default(autoincrement())
  id                  String             @unique @default(uuid()) @db.Uuid
  employeeId          String             @unique @map("employee_id")
  email               String             @unique
  phone               String?            @unique
  password            String
  status              GuardStatus        @default(RECRUITED)
  emailVerified       Boolean            @default(false) @map("email_verified")
  phoneVerified       Boolean            @default(false) @map("phone_verified")
  lastLoginAt         DateTime?          @map("last_login_at")
  recruitedAt         DateTime           @default(now()) @map("recruited_at")
  retiredAt           DateTime?          @map("retired_at")

  // Tenant scope — which security company employs this guard
  companyPk           Int                @map("company_pk")
  companyId           String             @map("company_id") @db.Uuid
  company              Company           @relation(fields: [companyPk, companyId], references: [pk, id], onDelete: Restrict, onUpdate: Cascade)

  // Base compensation — configurable per deployment via GuardDeployment.guardPayRate
  baseSalary          Float              @default(0) @map("base_salary")
  salaryBankName      String?            @map("salary_bank_name")
  salaryAccountNumber String?            @map("salary_account_number")
  salaryAccountName   String?            @map("salary_account_name")

  profile             GuardProfile?
  backgroundCheck     GuardBackgroundCheck?
  trainings           GuardTraining[]
  certifications      GuardCertification[]
  equipmentAssignments EquipmentAssignment[]

  // Deployments — the core link to clients/sites (must be within the same company)
  deployments         GuardDeployment[]

  leaveRequests       LeaveRequest[]
  overtimeRequests    OvertimeRequest[]
  kpiScores           GuardKpiScore[]
  payrollLines        PayrollLine[]       // guard's payroll history across all deployments
  notifications       Notification[]
  apiKeys             ApiKey[]

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([pk, id])
  @@map("guards")
}

model GuardProfile {
  pk                       Int                     @id @default(autoincrement())
  id                       String                  @unique @default(uuid()) @db.Uuid
  photo                    String?
  dob                      DateTime?
  firstName                String                  @map("first_name")
  lastName                 String                  @map("last_name")
  middleName               String?                 @map("middle_name")
  gender                   Gender?
  nationality              String?
  homeAddress              String?                 @map("home_address")
  city                     String?
  state                    String?
  country                  String?
  postalCode               String?                 @map("postal_code")
  idType                   IdentificationCardType? @map("id_type")
  idNumber                 String?                 @map("id_number")
  idVerified               VerificationStatus      @default(NOT_VERIFIED) @map("id_verified")
  idDocument               String?                 @map("id_document")
  emergencyContactName     String?                 @map("emergency_contact_name")
  emergencyContactPhone    String?                 @map("emergency_contact_phone")
  emergencyContactRelation String?                 @map("emergency_contact_relation")

  guardPk   Int    @unique @map("guard_pk")
  guardId   String @unique @map("guard_id") @db.Uuid
  guard     Guard  @relation(fields: [guardPk, guardId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pk, id])
  @@unique([guardPk, guardId])
  @@map("guard_profiles")
}

// Background check
model GuardBackgroundCheck {
  pk              Int                   @id @default(autoincrement())
  id              String                @unique @default(uuid()) @db.Uuid
  status          BackgroundCheckStatus @default(PENDING)
  initiatedAt     DateTime              @default(now()) @map("initiated_at")
  completedAt     DateTime?             @map("completed_at")
  provider        String?               // if third-party screening company name
  referenceNumber String?               @map("reference_number")
  notes           String?
  documentUrl     String?               @map("document_url") // report upload
  passedAt        DateTime?             @map("passed_at")
  failedAt        DateTime?             @map("failed_at")
  failReason      String?               @map("fail_reason")

  guardPk         Int                   @unique @map("guard_pk")
  guardId         String                @unique @map("guard_id") @db.Uuid
  guard           Guard                 @relation(fields: [guardPk, guardId], references: [pk, id], onDelete: Cascade, onUpdate: Cascade)

  conductedByPk   Int?                  @map("conducted_by_pk")
  conductedById   String?               @map("conducted_by_id") @db.Uuid
  conductedBy     Staff?                @relation("background_checker", fields: [conductedByPk, conductedById], references: [pk, id], onDelete: SetNull, onUpdate: Cascade)

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([pk, id])
  @@unique([guardPk, guardId])
  @@map("guard_background_checks")
}

// Training 
model GuardTraining {
  pk            Int            @id @default(autoincrement())
  id            String         @unique @default(uuid()) @db.Uuid
  name          String         // e.g. "Basic Security Training", "First Aid"
  description   String?
  status        TrainingStatus @default(ENROLLED)
  startDate     DateTime       @map("start_date") @db.Date
