// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// ============================================================
// TSNL SECURITY MANAGEMENT SYSTEM (SMS)
// Prisma Schema — v1.0
// ============================================================
//
// The `Company` is as a tenant
// root: any number of security companies can onboard and
// subscribe to the platform, each bringing their own internal
// Staff, Guards, Roles, Equipment pool, and book of Clients.

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x","debian-openssl-3.0.x"]
  previewFeatures = ["interactiveTransactions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================
// ENUMS
// =====================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum VerificationStatus {
  NOT_VERIFIED
  PENDING
  APPROVED
  DECLINED
}

enum IdentificationCardType {
  DRIVERS_LICENSE
  INTERNATIONAL_PASSPORT
  NATIONAL_ID
  VOTERS_CARD
}

// ------ company (tenant) lifecycle ------

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  CHURNED
}

// ------ guard lifecycle------

enum GuardStatus {
  RECRUITED          // Just joined, pending background check
  BACKGROUND_CHECK   // Under background screening
  TRAINING           // In training programme
  READY              // Cleared, in the pool, awaiting deployment
  DEPLOYED           // Currently assigned to at least one client
  SUSPENDED          // Temporarily pulled from all deployments
  RETIRED            // Exited the company
}

enum BackgroundCheckStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
  REQUIRES_REVIEW
}

enum TrainingStatus {
  ENROLLED
  IN_PROGRESS
  PASSED
  FAILED
  WAIVED           // no training needed
}

// ------ deployment ------

enum DeploymentStatus {
  ACTIVE             // Guard is currently serving this client
  ENDED              // Deployment closed (contract lost, rotation end, etc.)
  SUSPENDED          // Temporarily paused at this deployment
  TRANSFERRED        // Guard moved to another deployment
}

enum DeploymentEndReason {
  CONTRACT_LOST
  CONTRACT_ENDED
  GUARD_REQUEST
  CLIENT_REQUEST
  DISCIPLINARY
  ROTATION
  OTHER
}

// ------ clients ------

enum ClientType {
  ORGANIZATION       // Corporate — security companies, hospitals, schools, govt
  INDIVIDUAL         // Residential — estates, homes, small facilities
}

enum IndividualAccountType {
  ESTATE
  RESIDENCE
  SMALL_FACILITY
  FARM
  OTHER
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  CHURNED
}

enum OnboardingMethod {
  SELF_SIGNUP        // via the app
  STAFF_ONBOARDED    // backend onboarding
}

// ------ sites ------

enum SiteClassification {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  GOVERNMENT
  EDUCATIONAL
  HEALTHCARE
  MIXED_USE
}

// ------ internal staff ------

enum StaffRole {
  SUPER_ADMIN
  HR_MANAGER
  OPERATIONS_MANAGER
  SECURITY_SUPERVISOR
  CONTROL_ROOM_OPERATOR
  FINANCE_OFFICER
  ACCOUNT_MANAGER      // Manages client relationships
}

// ------ platform (cross-tenant) staff ------

enum PlatformStaffRole {
  PLATFORM_SUPER_ADMIN   // Anthropic-of-the-platform — manages all companies
  PLATFORM_SUPPORT
  PLATFORM_BILLING
}

// ------ shift & attendance ------

enum ShiftType {
  DAY
  NIGHT
  ROTATIONAL
  CUSTOM
}

enum AttendanceMethod {
  GPS
  QR_CODE
  BIOMETRIC
  MANUAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  EMERGENCY
  MATERNITY
  PATERNITY
  UNPAID
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
}

// ------ incident ------

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentType {
  THEFT
  TRESPASSING
  VANDALISM
  FIRE
  MEDICAL_EMERGENCY
  ASSAULT
  SUSPICIOUS_ACTIVITY
  PROPERTY_DAMAGE
  ACCESS_VIOLATION
  OTHER
}

enum IncidentStatus {
