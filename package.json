{
  "name": "moola-backend",
  "version": "0.0.1",
  "description": "moola app UAT",
  "author": "VSI",
  "private": true,
  "license": "UNLICENSED",
  "prisma": {
    "seed": "ts-node --transpile-only ./prisma/seed.ts"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migrate:dev": "prisma migrate dev ",
    "migrate:dev:create": "prisma migrate dev --create-only",
    "migrate:deploy": "npx prisma migrate deploy --preview-feature",
    "prisma": "prisma",
    "prisma:generate": "prisma generate",
    "generate-dummy": "ts-node ./src/scripts/dummy.ts",
    "create:staff": "ts-node ./src/scripts/createStaff.ts",
    "create:clientstaff": "ts-node ./src/scripts/createclientstaff.ts",
    "create:guard": "ts-node ./src/scripts/createGuard.ts",
    "create:client": "ts-node ./src/scripts/createClient.ts",
    "create:apikey:staff": "ts-node ./src/scripts/createApiKey.ts --staff",
    "create:apikey:guard": "ts-node ./src/scripts/createApiKey.ts --guard",
    "create:apikey:client": "ts-node ./src/scripts/createApiKey.ts --client",
    "create:apikey:clientstaff": "ts-node ./src/scripts/createApiKey.ts --clientstaff",
    "generateSecureKey": "ts-node ./src/scripts/generateSecureKey.ts"
  },
  "dependencies": {
    "@adminjs/express": "^5.1.0",
    "@adminjs/nestjs": "^5.1.1",
    "@adminjs/prisma": "^3.0.1",
    "@bull-board/api": "^5.3.1",
    "@bull-board/express": "^5.3.1",
    "@bull-board/nestjs": "^5.3.1",
    "@golevelup/ts-jest": "^0.3.4",
    "@nestjs-modules/mailer": "^1.8.1",
    "@nestjs/axios": "^2.0.0",
    "@nestjs/bull": "^0.6.3",
    "@nestjs/common": "^9.0.0",
    "@nestjs/config": "^2.3.1",
    "@nestjs/core": "^9.0.0",
    "@nestjs/jwt": "^10.1.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^9.3.8",
    "@nestjs/schedule": "^2.2.1",
    "@nestjs/swagger": "^6.1.3",
    "@prisma/client": "^4.0.0",
    "adminjs": "^6.8.7",
    "axios": "^1.3.2",
    "bcrypt": "^5.1.1",
    "buffer-to-stream": "^1.0.0",
    "bull": "^4.10.4",
    "cache-manager": "^5.1.6",
    "cache-manager-redis-store": "^3.0.1",
    "cache-manager-redis-yet": "^4.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "cloudinary": "^1.33.0",
    "connect-redis": "^6.1.3",
    "csv-parse": "^5.6.0",
    "currency.js": "^2.0.4",
    "date-fns": "^2.29.3",
    "deasyncify": "^0.0.4",
    "dotenv": "^16.0.3",
    "express-basic-auth": "^1.2.1",
    "express-formidable": "^1.2.0",
    "express-session": "^1.17.3",
    "firebase-admin": "^11.10.1",
    "handlebars": "^4.7.7",
    "hbs": "^4.2.0",
    "html-pdf-node": "^1.0.8",
    "ioredis": "^5.2.4",
    "mailgun.js": "^8.0.6",
    "moment": "^2.29.4",
    "nest-winston": "^1.9.1",
    "nestjs-mailgun": "^3.1.5",
    "nodemailer": "^6.9.1",
    "openpgp": "4.10.11",
    "openpgpnew": "npm:openpgp@5.11.2",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.13.0",
    "puppeteer": "^21.3.4",
    "rate-limiter-flexible": "^7.2.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.2.0",
    "uuid": "^9.0.0",
    "uuid-random": "^1.3.2",
    "winston": "^3.8.2",
    "xlsx": "^0.18.5",
    "yargs": "^17.7.1"
  },
  "resolutions": {
    "@tiptap/core": "2.0.3",
    "@tiptap/pm": "2.0.3",
    "@tiptap/starter-kit": "2.0.3",
    "wrap-ansi": "7.0.0",
    "string-width": "4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.2.0",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^9.2.1",
    "@types/bcrypt": "^5.0.0",
    "@types/bull": "^4.10.0",
    "@types/connect-redis": "^0.0.19",
    "@types/cron": "^2.0.1",
    "@types/express": "^4.17.13",
    "@types/express-session": "^1.17.5",
    "@types/jest": "27.5.0",
    "@types/multer": "^1.4.7",
    "@types/node": "^16.0.0",
    "@types/nodemailer": "^6.4.7",
    "@types/pdfkit": "^0.12.10",
    "@types/supertest": "^2.0.11",
    "@types/yargs": "^17.0.22",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "28.0.3",
    "jest-mock-extended": "2.0.4",
    "prettier": "^2.3.2",
    "prisma": "^4.0.0",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "28.0.1",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "4.0.0",
    "typescript": "^4.9.5"
  },
  "jest": {
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "moduleNameMapper": {
      "@api/(.*)": "<rootDir>/api/$1",
      "@core/(.*)": "<rootDir>/core/$1",
      "@config/(.*)": "<rootDir>/config/$1",
      "@common/(.*)": "<rootDir>/common/$1",
      "@database/(.*)": "<rootDir>/database/$1",
      "@modules/(.*)": "<rootDir>/modules/$1",
      "@redis/(.*)": "<rootDir>/redis/$1",
      "@repositories/(.*)": "<rootDir>/repositories/$1"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
